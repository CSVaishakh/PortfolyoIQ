# PortfolioIQ reverse proxy.
#
# Application services are native EC2 processes, not containers, bound to
# 127.0.0.1 only. This container runs with `network_mode: host` (see
# compose.yml) specifically so that "127.0.0.1" here means the same loopback
# those services are actually listening on — a bridge network's
# host.docker.internal resolves to the bridge gateway, a different interface
# that a 127.0.0.1-bound service never answers on.
#
# Route split is deliberate: the React client owns a UI page at exactly
# "/auth" (app/auth/), while the platform API separately owns "/auth/signup"
# and "/auth/signin". A blanket "/auth*" prefix would swallow the UI page, so
# the platform API is matched by its exact known paths instead of a prefix.
{
	# admin@example.com
}

portfolyo-iq.duckdns.org {
	encode zstd gzip

	@platformApi {
		path /auth/signup /auth/signin
		path /client/*
		path /model/*
		path /health
	}

	handle @platformApi {
		reverse_proxy 127.0.0.1:5000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
